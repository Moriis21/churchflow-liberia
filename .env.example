# InsForge Anon Key (safe to expose — public key only)
VITE_INSFORGE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3OC0xMjM0LTU2NzgtOTBhYi1jZGVmMTIzNDU2NzgiLCJlbWFpbCI6ImFub25AaW5zZm9yZ2UuY29tIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzkwNTg1NDN9.T6Hez8IG158KImBeKlESruM0Rm9KNGEIDtBbRbw6ano

# ============================================================
# SERVER-SIDE ONLY — set via `insforge functions secrets set ...`
# Never commit real values. These are read by edge functions, NEVER
# exposed to the browser. No VITE_ prefix on purpose.
# ============================================================

# Resend transactional email API key
RESEND_API_KEY=re_your_new_resend_key_here

# Friendly From header — must be a domain verified in Resend
FROM_EMAIL=ChurchFlow Liberia <noreply@yourdomain.com>

# Optional — override the welcome-email login CTA
CHURCHFLOW_LOGIN_URL=https://churchflow-liberia.vercel.app/login
